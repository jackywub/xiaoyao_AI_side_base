# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/xiaoyao_ai_base"

# Public origin used to validate same-origin form and API requests.
APP_URL="http://localhost:3003"

# Initial administrator credentials used by `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-at-least-12-random-characters"

# Maximum connections used by the application process.
DATABASE_CONNECTION_LIMIT="5"

# 32-byte hexadecimal key used to encrypt external API credentials.
SETTINGS_ENCRYPTION_KEY="replace-with-64-hexadecimal-characters"

# Optional local Hermes CLI used by the workspace AI assistant.
# HERMES_BIN="/absolute/path/to/hermes"
HERMES_TIMEOUT_MS="120000"

# Optional source overrides for `npm run db:merge:systems`.
# MANAGEMENT_STATE_PATH="/absolute/path/to/app-state.json"
# CONTENT_DATABASE_PATH="/absolute/path/to/payload.db"

# Optional: use a separate shadow database for Prisma migrate dev.
# SHADOW_DATABASE_URL="mysql://root:password@127.0.0.1:3306/xiaoyao_ai_base_shadow"
