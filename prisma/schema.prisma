  workspaceId     String        @db.VarChar(30)
  readOn          DateTime      @db.Date
  durationSeconds Int           @default(0)
  source          ReadingSource @default(WEREAD)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @db.DateTime(3)

  @@unique([workspaceId, readOn, source])
  @@index([workspaceId, readOn])
  @@map("reading_daily_stats")
}

model ReadingShelfState {
