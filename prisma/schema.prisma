model ExternalConnection {
  id              String                   @id @default(cuid()) @db.VarChar(30)
  workspaceId     String                   @db.VarChar(30)
  provider        ExternalProvider
  status          ExternalConnectionStatus @default(DISCONNECTED)
  encryptedConfig String?                  @db.LongText
  lastSyncedAt    DateTime?                @db.DateTime(3)
  lastError       String?                  @db.Text
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  syncLogs        ExternalSyncLog[]
  createdAt       DateTime                 @default(now()) @db.DateTime(3)
  updatedAt       DateTime                 @updatedAt @db.DateTime(3)

  @@unique([workspaceId, provider])
  @@index([status, lastSyncedAt])
  @@map("external_connections")
}

model ExternalSyncLog {
  id           String             @id @default(cuid()) @db.VarChar(30)
  connectionId String             @db.VarChar(30)
  resourceType String             @db.VarChar(100)
  resourceId   String?            @db.VarChar(30)
  status       ExternalSyncStatus @default(PENDING)
  message      String?            @db.Text
  startedAt    DateTime           @default(now()) @db.DateTime(3)
  completedAt  DateTime?          @db.DateTime(3)
  connection   ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now()) @db.DateTime(3)
  updatedAt    DateTime           @updatedAt @db.DateTime(3)

  @@index([connectionId, startedAt])
  @@index([status, startedAt])
  @@map("external_sync_logs")
}

model AiConversation {
  id                String      @id @default(cuid()) @db.VarChar(30)
  workspaceId       String      @db.VarChar(30)
  title             String      @default("成长助手") @db.VarChar(200)
  provider          String?     @db.VarChar(100)
  model             String?     @db.VarChar(200)
  externalSessionId String?     @db.VarChar(191)
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages          AiMessage[]
  createdAt         DateTime    @default(now()) @db.DateTime(3)
  updatedAt         DateTime    @updatedAt @db.DateTime(3)

  @@index([workspaceId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid()) @db.VarChar(30)
  conversationId String         @db.VarChar(30)
  role           AiMessageRole
  content        String         @db.LongText
  model          String?        @db.VarChar(200)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @db.DateTime(3)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
